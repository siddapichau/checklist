rules_version = '2';

// =========================================================
// CHECKLIST ML — Firebase Storage Security Rules (CORRIGIDO)
// Pastas: avatars/, posts/, files/, themes/
// =========================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userExists() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() &&
             userExists() &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEditorOrAdmin() {
      return isSignedIn() &&
             userExists() &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'];
    }

    // FIX: se user doc não existe ainda (primeiro login), permitir
    function isNotBanned() {
      return isSignedIn() && (
        !userExists() ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.banned != true
      );
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSmallImage() {
      return request.resource.size < 2 * 1024 * 1024;
    }

    function isLargeImage() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
                   && isNotBanned()
                   && isImage()
                   && isSmallImage();
    }

    match /posts/{postId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isEditorOrAdmin()
                   && isNotBanned()
                   && isImage()
                   && isLargeImage();
    }

    match /files/{fileId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isEditorOrAdmin()
                   && isNotBanned()
                   && isLargeImage();
    }

    match /themes/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId)
                   && isNotBanned()
                   && isImage()
                   && isSmallImage();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
